{% extends 'base.html.twig' %}

{% block title %}Contact | Meta Galeries{% endblock %}

{% block body %}
    <div class="full-height-page p-4">
        <div class="medium-container">
            {{ include('common/flashbag.html.twig') }}
            <h3 class="contact-title">Nous contacter</h3>
            {{ form_start(contactForm, {'attr': {'id': 'contactForm'}}) }}
                {{ form_row(contactForm.sex) }}
                {{ form_row(contactForm.firstName) }}
                {{ form_row(contactForm.lastName) }}
                {{ form_row(contactForm.email) }}
                {{ form_row(contactForm.content) }}

                <button class="btn button-primary mt-1" type="submit">Envoyer</button>
            {{ form_end(contactForm) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('full-height-page') }}
    {{ encore_entry_script_tags('contact') }}
{% endblock %}
