{{ form_start(registrationForm, {'action': path('app_register'), 'attr': {'id': 'registrationForm'}}) }}
    <div class="form-box-header registration-form-header">
        <label class="form-box-header-radio" for="registrationFormRadio">
            <input class="radio-input" type="radio" name="" id="registrationFormRadio">
            <div class="radio-circle"></div>
            Créer un compte
        </label>
    </div>
    <div class="form-box-body registration-form-body">
        <fieldset class="form-group">
            <label for="{{ registrationForm.lastName.vars.id }}">
                {{ registrationForm.lastName.vars.label }}
            </label>
            <input
                class="form-control registration-form-lastname-input"
                type="text"
                id="{{ registrationForm.lastName.vars.id }}"
                name="{{ registrationForm.lastName.vars.full_name }}"
                value="{{ registrationForm.lastName.vars.value }}"
                maxlength="50"
            >
            <span class="register-lastname-error">
                <i class="fa-solid fa-exclamation"></i>
                <small>Error message will be generated here by JS</small>
            </span>
        </fieldset>
        <fieldset class="form-group">
            <label for="{{ registrationForm.email.vars.id }}">
                {{ registrationForm.email.vars.label }}
            </label>
            <input
                class="form-control registration-form-email-input"
                type="text"
                id="{{ registrationForm.email.vars.id }}"
                name="{{ registrationForm.email.vars.full_name }}"
                value="{{ registrationForm.email.vars.value }}"
            >
            <span class="register-email-error">
                <i class="fa-solid fa-exclamation"></i>
                <small>Error message will be generated here by JS</small>
            </span>
        </fieldset>
        <fieldset class="form-group">
            <label for="{{ registrationForm.password.first.vars.id }}">
                {{ registrationForm.password.first.vars.label }}
            </label>
            <input
                class="form-control fist-password-input"
                type="password"
                id="{{ registrationForm.password.first.vars.id }}"
                name="{{ registrationForm.password.first.vars.full_name }}"
                autocomplete="off"
            >
            <span class="first-password-error">
                <i class="fa-solid fa-exclamation"></i>
                <small>Error message will be generated here by JS</small>
            </span>
        </fieldset>
        <fieldset class="form-group">
            <label for="{{ registrationForm.password.second.vars.id }}">
                {{ registrationForm.password.second.vars.label }}
            </label>
            <input
                class="form-control second-password-input"
                type="password"
                id="{{ registrationForm.password.second.vars.id }}"
                name="{{ registrationForm.password.second.vars.full_name }}"
                autocomplete="off"
            >
            <span class="second-password-error">
                <i class="fa-solid fa-exclamation"></i>
                <small>Error message will be generated here by JS</small>
            </span>
        </fieldset>

        <button class="btn button-primary mt-1" type="submit">Continuer</button>
    </div>

    {% do registrationForm.lastName.setRendered %}
    {% do registrationForm.email.setRendered %}
    {% do registrationForm.password.setRendered %}
{{ form_end(registrationForm) }}
