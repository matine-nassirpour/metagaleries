{% extends 'base.html.twig' %}

{% block title %}Meta Galeries | Haut de gamme pour un look irréprochable{% endblock %}

{% block body %}
    <section>
        <div class="home-slider owl-carousel">
            {% for header in headers %}
                <div class="slider-item">
                    <img src="{{ asset('build/uploads/products/'~header.illustration) }}" alt="Meta Galeries">
                    <div class="item-description">
                        <h1>{{ header.title }}</h1>
                        <p>{{ header.subtitle }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    <section class="best-selling">
        <div class="row">
            {% for product in products %}
                {{ include('common/product.html.twig') }}
            {% endfor %}
        </div>
    </section>
    <div class="divider-inner after-white mt-4"></div>
    <section>
        <div class="container">
            <div class="row featurette mt-3">
                <div class="col-md-7">
                    <h2 class="featurette-heading">
                        Costumes Homme
                        <span class="text-muted">Au grand savoir-faire</span>
                    </h2>
                    <p class="lead color-secondary-text featurette-p">
                        Meta Galeries vous propose une gamme complète de costumes et smokings adaptés à chaque occasion.
                        De la création à la confection, nous faisons appel aux meilleurs savoir-faire pour vous garantir
                        une silhouette soignée et élégante et déclinons cette pièce emblématique du vestiaire masculin
                        dans un large choix de couleurs et de matières.
                    </p>
                </div>
                <div class="col-md-5">
                    <img class="img-fluid" src="{{ asset('build/images/6765639.39b6de21.jpg') }}" alt="Meta Galeries">
                </div>
            </div>
            <hr class="light-divider mt-5">
            <div class="row featurette my-5">
                <div class="col-md-7 order-md-2">
                    <h2 class="featurette-heading">
                        Accessoires Femme
                    </h2>
                    <p class="lead color-secondary-text featurette-p">
                        Quelle que soit l’occasion, il n’est pas de look parfaitement maîtrisé sans un accessoire
                        approprié et choisi avec soin. En plus de mettre en valeur discrètement votre tenue, un
                        accessoire tel une ceinture, une pince à cravate ou une paire de gants vous permet également
                        d’exprimer votre personnalité.
                    </p>
                </div>
                <div class="col-md-5 order-md-1">
                    <img class="img-fluid" src="{{ asset('build/images/8762510.9c13b8f5.jpg') }}" alt="Meta Galeries">
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('home') }}
{% endblock %}
