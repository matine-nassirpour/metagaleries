{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié | Meta Galeries{% endblock %}

{% block header %}
    {{ include('common/login_register_header.html.twig') }}
{% endblock %}

{% block bodyClass %}login-register-background{% endblock %}

{% block body %}
    <div class="login-register-portal">
        <div class="portal-container">
            {{ include('common/flashbag.html.twig') }}
            <div class="forms-box">
                <form method="POST">
                    <div class="forgot-password-header">
                        <h4>Assistance mot de passe</h4>
                        <p class="color-secondary-text mb-2">Saisissez l'adresse e-mail associée à votre compte Meta Galeries.</p>
                    </div>
                    <div class="form-box-body">
                        <fieldset class="form-group">
                            <label for="inputEmail">Adresse e-mail</label>
                            <input
                                class="form-control forgot-password-email-input"
                                type="text"
                                id="inputEmail"
                                name="email"
                                autocomplete="email"
                                autofocus
                            >
                        </fieldset>

                        <button class="btn button-primary mt-1" type="submit">Continuer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}
    {{ include('common/login_register_footer.html.twig') }}
{% endblock %}

{% block javascripts %}{% endblock %}
