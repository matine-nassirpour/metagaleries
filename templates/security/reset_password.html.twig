{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié | Meta Galeries{% endblock %}

{% block header %}
    {{ include('common/login_register_header.html.twig') }}
{% endblock %}

{% block bodyClass %}login-register-background{% endblock %}

{% block body %}
    <div class="login-register-portal">
        <div class="portal-container">
            {{ include('common/flashbag.html.twig') }}
            <div class="forms-box">
                {{ form_start(resetPasswordForm, {'attr': {'id': 'resetPasswordForm'}}) }}
                    <div class="forgot-password-header">
                        <h4>Réinitialiser votre mot de passe</h4>
                    </div>
                    <div class="form-box-body">
                        <fieldset class="form-group">
                            <label for="{{ resetPasswordForm.newPassword.first.vars.id }}">
                                {{ resetPasswordForm.newPassword.first.vars.label }}
                            </label>
                            <input
                                class="form-control fist-password-input"
                                type="password"
                                id="{{ resetPasswordForm.newPassword.first.vars.id }}"
                                name="{{ resetPasswordForm.newPassword.first.vars.full_name }}"
                                autocomplete="off"
                            >
                            <span class="first-password-error">
                                <i class="fa-solid fa-exclamation"></i>
                                <small>Error message will be generated here by JS</small>
                            </span>
                        </fieldset>
                        <fieldset class="form-group">
                            <label for="{{ resetPasswordForm.newPassword.second.vars.id }}">
                                {{ resetPasswordForm.newPassword.second.vars.label }}
                            </label>
                            <input
                                class="form-control second-password-input"
                                type="password"
                                id="{{ resetPasswordForm.newPassword.second.vars.id }}"
                                name="{{resetPasswordForm.newPassword.second.vars.full_name }}"
                                autocomplete="off"
                            >
                            <span class="second-password-error">
                                <i class="fa-solid fa-exclamation"></i>
                                <small>Error message will be generated here by JS</small>
                            </span>
                        </fieldset>

                        <button class="btn button-primary mt-1" type="submit">Réinitialiser</button>
                    </div>

                    {% do resetPasswordForm.newPassword.setRendered %}
                {{ form_end(resetPasswordForm) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}
    {{ include('common/login_register_footer.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('reset-password') }}
{% endblock %}
