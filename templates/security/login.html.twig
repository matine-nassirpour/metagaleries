{% extends 'base.html.twig' %}

{% block title %}Connexion Meta Galeries{% endblock %}

{% block header %}
    {{ include('common/auth_header.html.twig') }}
{% endblock %}

{% block body %}
    <div class="auth-portal">
        <div class="auth-portal-container">
            <div class="forms-box">
                {{ render(controller('App\\Controller\\RegistrationController::register')) }}

                <form method="post">
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <div class="form-box-header login-form-header">
                        <label class="form-box-header-radio" for="loginFormRadio">
                            <input class="radio-input" type="radio" name="" id="loginFormRadio" checked>
                            <div class="radio-circle"></div>
                            S'identifier
                        </label>
                    </div>
                    <div class="form-box-body login-form-body">
                        <fieldset class="form-group">
                            <label for="inputEmail">Adresse e-mail</label>
                            <input class="form-control" type="text" value="{{ last_username }}" name="email" id="inputEmail" autocomplete="email" autofocus>
                        </fieldset>
                        <fieldset>
                            <label for="inputPassword">Mot de passe</label>
                            <input class="form-control" type="password" name="password" id="inputPassword" autocomplete="current-password">
                        </fieldset>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        {#
                            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                            See https://symfony.com/doc/current/security/remember_me.html

                            <div class="checkbox mb-3">
                                <label>
                                    <input type="checkbox" name="_remember_me"> Remember me
                                </label>
                            </div>
                        #}

                        <button class="btn primary-button mt-1" type="submit">S'identifier</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('login-register') }}
{% endblock %}
