{% extends 'base.html.twig' %}

{% block title %}Connexion | Meta Galeries{% endblock %}

{% block header %}
    {{ include('common/login_register_header.html.twig') }}
{% endblock %}

{% block bodyClass %}login-register-background{% endblock %}

{% block body %}
    <div class="login-register-portal">
        <div class="portal-container">
            <h4>Bienvenue</h4>
            {{ include('common/flashbag.html.twig') }}
            <div class="forms-box">
                {{ render(controller('App\\Controller\\RegistrationController::register')) }}

                <form id="loginForm" method="POST" action="{{ path('app_login') }}">
                    <div class="form-box-header login-form-header">
                        <label class="form-box-header-radio" for="loginFormRadio">
                            <input class="radio-input" type="radio" name="" id="loginFormRadio" checked>
                            <div class="radio-circle"></div>
                            S'identifier
                        </label>
                    </div>
                    <div class="form-box-body login-form-body">
                        <fieldset class="form-group">
                            <label for="inputEmail">Adresse e-mail</label>
                            <input
                                class="form-control login-form-email-input"
                                type="text" value="{{ last_username }}"
                                id="inputEmail"
                                name="email"
                                autocomplete="email"
                                autofocus
                            >
                            <span class="login-email-error">
                                <i class="fa-solid fa-exclamation"></i>
                                <small>Error message will be generated here by JS</small>
                            </span>
                        </fieldset>
                        <fieldset>
                            <label for="inputPassword">Mot de passe</label>
                            <input
                                class="form-control login-password-input"
                                type="password" name="password"
                                id="inputPassword"
                                autocomplete="current-password"
                            >
                            <span class="login-password-error">
                                <i class="fa-solid fa-exclamation"></i>
                                <small>Error message will be generated here by JS</small>
                            </span>
                        </fieldset>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        {#
                            <div class="checkbox mb-3">
                                <label>
                                    <input type="checkbox" name="_remember_me"> Remember me
                                </label>
                            </div>
                        #}

                        <button class="btn button-primary mt-1" type="submit">S'identifier</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}
    {{ include('common/login_register_footer.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('login-register') }}
{% endblock %}
