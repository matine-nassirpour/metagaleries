{% extends 'base.html.twig' %}

{% block title %}Paiement de commande | Meta Galeries{% endblock %}

{% block body %}
    <div class="full-height-page p-4">
        <div class="medium-container passed-order-container">
            <h3>Récapitulatif de votre commande</h3>
            <hr class="mb-4">
            <div class="row">
                <div class="col-md-7">
                    <div class="selected-address-container mb-3">
                        <h6 class="color-secondary-text">Votre adresse de livraison</h6>
                        <div class="d-flex flex-column">
                            <span>{{ address.fullName }}</span>
                            <span>{{ address.address }}</span>
                            <span>{{ address.zipCode ~ ' ' ~ address.city }}</span>
                            <span>{{ address.country|country_name }}</span>
                        </div>
                    </div>
                    <div class="selected-carrier-container">
                        <h6 class="color-secondary-text">Votre transporteur</h6>
                        <div class="d-flex flex-column">
                            <span>{{ carrier.name }}</span>
                            <span>{{ carrier.description }}</span>
                        </div>
                    </div>
                </div>
                <div class="order-summary-container col-md-5">
                    <h6 class="pb-4 mb-0 fs-7 text-uppercase color-secondary-text">
                        {% if cart|length == 1 %}
                            {{ cart|length }} Produit
                        {% else %}
                            {{ cart|length }} Produits
                        {% endif %}
                    </h6>
                    {% set total = null %}
                    {% for product in cart %}
                        {% set price = product.product.price/100 %}
                        <div class="product-summary-box">
                            <div class="">
                                <img src="{{ asset('build/uploads/products/'~product.product.illustration) }}" alt="{{ product.product.name }}" width="100">
                            </div>
                            <div class="d-flex flex-column">
                                <h4 class="text-uppercase fw-bold fs-7">{{ product.product.name }}</h4>
                                <div class="d-flex">
                                    <small class="color-secondary-text text-uppercase">Qté : &nbsp;</small>
                                    <span>{{ product.quantity }}</span>
                                </div>
                                <div class="d-flex">
                                    <small class="color-secondary-text text-uppercase">Prix : &nbsp;</small>
                                    <span> {{ price|format_currency('EUR', {fraction_digit: 2}) }}</span>
                                </div>
                            </div>
                        </div>
                        {% set subtotal = (price * product.quantity) %}
                        {% set total = total + subtotal %}
                    {% endfor %}
                    <div class="d-flex justify-content-between mt-3 text-uppercase color-secondary-text">
                        <span>Sous-total</span>
                        <span>{{ total|format_currency('EUR', {fraction_digit: 2}) }}</span>
                    </div>
                    {% set carrierPrice = carrier.price/100 %}
                    <div class="d-flex justify-content-between mt-3 text-uppercase color-secondary-text">
                        <span>Livraison</span>
                        <span>{{ carrierPrice|format_currency('EUR', {fraction_digit: 2}) }}</span>
                    </div>
                    {% set totalPrice = total + carrierPrice %}
                    <div class="d-flex justify-content-between mt-3 text-uppercase fs-7 fw-bold">
                        <span>Total</span>
                        <span>{{ totalPrice|format_currency('EUR', {fraction_digit: 2}) }}</span>
                    </div>
                    <div class="divider-inner after-whitesmoke mt-4"></div>
                    <div class="a-button-container">
                        <a class="order-payment-button" id="checkout-button">
                            <div class="a-button a-button-tertiary">
                                <img class="mr-2" src="{{ asset('build/images/lock.png') }}" alt="Paiement sécurisé" width="15">
                                <span class="a-button-inner">
                                    Paiement sécurisé
                                </span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('full-height-page') }}
    <script src="https://js.stripe.com/v3/"></script>
    <script defer>
        var stripe = Stripe('pk_test_51L5uvnDbDyAwt1rEDkMEFzoLLjDDHz2xzPnmJA5ECPW02im4h4TqXbdjOxDwTMTw1TvJAAfIH0hanrLbRk7jL3WF00MT5QvhNh');
        var checkoutButton = document.getElementById('checkout-button');

        checkoutButton.addEventListener('click', function () {
            fetch('/order/create-session/{{ reference }}', {
                method: 'POST',
            })
                .then(function(response) {
                    return response.json();
                })
                .then(function(session) {
                    return stripe.redirectToCheckout({ sessionId: session.id });
                })
                .then(function(result) {
                    if (result.error) {
                        alert(result.error.message);
                    }
                });
        });
    </script>
{% endblock %}
