<header class="navbar-main">
    <div id="navbar" class="nav-flex">
        <div id="navBelt">
            <div class="nav-left">
                <div class="nav-logo">
                    <a href="{{ path('app_home') }}" class="nav-logo-link">
                        <img src="{{ asset('build/images/meta-galeries-logo-white.png') }}" alt="Logo">
                    </a>
                </div>
            </div>
            {#
            <div class="nav-fill">
                <div class="nav-search">
                    <form id="navSearchBarForm" class="nav-search-form" accept-charset="UTF-8" action="#" method="GET" name="site-search" role="search">
                        <label for="navSearchInput" hidden></label>
                        <input class="nav-search-input" type="text" id="navSearchInput" autocomplete="off" dir="auto">
                        <button type="submit" class="nav-search-button"><i class="fas fa-search"></i></button>
                    </form>
                </div>
            </div>
            #}
            <div class="nav-right">
                <div class="nav-tools">
                    {% if app.user %}
                        <div class="dropdown">
                            <a role="button" class="nav-a d-flex" id="dropDownButton">
                                <div class="nav-tool-logged-in-user">
                                    <small>{{ app.user.lastName|upper }}</small>
                                    <div class="d-flex">
                                        <span>Compte</span>
                                        <i class="logged-in-user-pointer fa fa-caret-down"></i>
                                    </div>
                                </div>
                                <div class="nav-tool-user">
                                    <i class="far fa-user"></i>
                                </div>
                            </a>
                            <div class="nav-dropdown-account-list" id="dropDownMenu">
                                <h6 class="mb-0 fw-bold pb-2">Votre compte</h6>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a class="pb-2" href="{{ path('admin') }}">Accéder au backoffice</a>
                                {% endif %}
                                <a class="pb-2" href="{{ path('app_account') }}">Votre compte</a>
                                <a href="{{ path('app_account_orders') }}">Vos commandes</a>
                                <hr class="light-divider my-2">
                                <a href="{{ path('app_logout') }}">Déconnexion</a>
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="nav-a d-flex">
                            <div class="nav-tool-user">
                                <i class="far fa-user"></i>
                            </div>
                        </a>
                    {% endif %}
                    <a href="{{ path('app_cart') }}" class="nav-a">
                        <div class="nav-tool-cart">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="nav-tool-cart-text">Panier</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
        <div id="navMain">
            <div class="nav-items">
                <a href="{{ path('app_products') }}" class="nav-a">Prêt à porter</a>
                <a href="#" class="nav-a">À propos</a>
                <a href="#" class="nav-a">Contact</a>
                <a href="#" class="nav-a">FAQ</a>
            </div>
        </div>
        <div id="navCover" class="nav-cover"></div>
    </div>
</header>
