{% extends 'base.html.twig' %}

{% block title %}Collections Meta Galeries{% endblock %}

{% block body %}
    <div class="large-container">
        <div class="row">
            <div class="col-md-3">
                {{ form_start(searchForm) }}
                    {# {{ form_row(searchForm.string) }} #}
                    {{ form_row(searchForm.categories) }}

                    <button class="btn button-primary mt-1" type="submit">Filtrer</button>
                {{ form_end(searchForm) }}
            </div>
            <div class="col-md-9">
                <div class="row w-100 m-auto">
                    {% for product in products %}
                        {% set price = product.price/100 %}
                        <div class="col-md-4">
                            <a href="{{ path('app_product', { 'slug': product.slug, 'id': product.id }) }}">
                                <div class="text-center">
                                    <img class="img-fluid" src="build/uploads/products/{{ product.illustration }}" alt="{{ product.name }}">
                                    <h5>{{ product.name|upper }}</h5>
                                    <span>{{ price|format_currency('EUR', {fraction_digit: 0}) }}</span>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
{#        <div class="d-flex pt-4 gap-2">#}
{#            <div style="max-width: 230px; width: 100%; height: 100%; padding: 14px 18px; border: 1px solid #DDD; border-radius: 4px">#}
{#                <h4>Blabal</h4>#}
{#                <p>Lorem ipsum dolor sit amet.</p>#}
{#            </div>#}
{#            #}
{#        </div>#}
    </div>
{% endblock %}
