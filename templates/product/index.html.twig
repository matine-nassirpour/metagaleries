{% extends 'base.html.twig' %}

{% block title %}Collections Meta Galeries{% endblock %}

{% block body %}
    <div class="large-container full-height-page">
        <div class="row">
            <div class="col-md-3 p-0">
                <details class="search-box" open>
                    <summary class="search-box-title">
                        Catégories
                        <i class="title-arrow fa-solid fa-angle-right"></i>
                    </summary>
                    <div class="search-box-form">
                        {{ form_start(searchForm, {'attr': {'id': 'searchForm'}}) }}
                        {{ form_widget(searchForm.categories) }}
                        {{ form_end(searchForm) }}
                    </div>
                </details>
            </div>
            <div class="col-md-9 p-0 pb-5">
                <div class="row w-100 m-auto">
                    {% for product in products %}
                        {% set price = product.price/100 %}
                        <div class="col-md-4">
                            <a href="{{ path('app_product', { 'slug': product.slug, 'id': product.id }) }}">
                                <div class="text-center">
                                    <img class="img-fluid" src="build/uploads/products/{{ product.illustration }}" alt="{{ product.name }}">
                                    <h5>{{ product.name|upper }}</h5>
                                    <span>{{ price|format_currency('EUR', {fraction_digit: 0}) }}</span>
                                </div>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {{ encore_entry_script_tags('products') }}

    <script>
        function makeFullHeightPage(stringPageContainerClassName) {
            const
                headerHeight = document.querySelector('.navbar-main').clientHeight,
                footerHeight = document.querySelector('.footer-main').clientHeight,
                page = document.querySelector(stringPageContainerClassName)
            ;

            return page.style.minHeight = `calc(100vh - (${headerHeight}px + ${footerHeight}px))`;
        }

        makeFullHeightPage('.full-height-page');
    </script>
{% endblock %}
