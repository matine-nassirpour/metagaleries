{% extends 'base.html.twig' %}

{% block title %}Meta Galeries {{ product.name }}{% endblock %}

{% block body %}
    <div class="product-container">
        <div class="container-xxl d-flex">
            <div class="col-md-8">
                <img class="img-fluid" src="/build/uploads/products/{{ product.illustration }}" alt="{{ product.name }}">
            </div>
            <div class="col-md-4">
                <h1>{{ product.name }}</h1>
            </div>
        </div>
    </div>
{% endblock %}

