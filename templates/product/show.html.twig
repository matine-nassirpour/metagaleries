{% extends 'base.html.twig' %}

{% block title %}Meta Galeries | {{ product.name|upper }}{% endblock %}

{% block body %}
    <div class="large-container full-height-page">
        <div class="product-navigation">
            <a href="{{ path('app_products') }}">Prêt à porter</a> / {{ product.name|upper }}
        </div>
        <div class="product-container">
            <div class="product-thumbnails">
                <div class="thumb-img-container">
                    <img src="{{ asset('build/uploads/products/'~product.illustration) }}" alt="{{ product.name }}">
                </div>
            </div>
            <div class="product-img-container" id="img-container">
                <img class="img-fluid" src="{{ asset('build/uploads/products/'~product.illustration) }}" alt="{{ product.name }}">
            </div>
            <div class="product-details">
                <div class="product-name-container">
                    <h2 class="fs-3 fw-bold text-uppercase">{{ product.name }}</h2>
                </div>
                <div class="product-price-container pt-1">
                    {% set price = product.price/100 %}
                    <span class="fs-5">
                        {{ price|format_currency('EUR', {fraction_digit: 0}) }}
                    </span>
                </div>
                <div class="a-button-container mt-4">
                    <a href="{{ path('app_increase_product', { 'id': product.id }) }}">
                        <div class="a-button a-button-tertiary">
                            <span class="a-button-inner">
                                Ajouter au panier
                            </span>
                        </div>
                    </a>
                </div>
                <div class="product-panel-group">
                    <details class="panel description-panel" open>
                        <summary class="panel-title">
                            Description
                            <i class="title-arrow fa-solid fa-angle-right"></i>
                        </summary>
                        <div class="panel-body">
                            <p>{{ product.detail }}</p>
                        </div>
                    </details>
                    <details class="panel detail-panel">
                        <summary class="panel-title">
                            Détails
                            <i class="title-arrow fa-solid fa-angle-right"></i>
                        </summary>
                        <div class="panel-body">
                            <p>{{ product.description|nl2br }}</p>
                        </div>
                    </details>
                    <details class="panel delivery-panel">
                        <summary class="panel-title">
                            Livraison
                            <i class="title-arrow fa-solid fa-angle-right"></i>
                        </summary>
                        <div class="panel-body">
                            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Autem laudantium natus quidem?</p>
                        </div>
                    </details>
                </div>
            </div>
        </div>
        <hr class="wide-divider">
        <div class="best-selling-container">
            <h2 class="fs-1 fw-bold text-uppercase mt-5">Meilleures ventes</h2>
            <div class="best-selling mw-100 mb-5">
                <div class="row">
                    {% for product in products %}
                        {{ include('common/product.html.twig') }}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('product') }}
{% endblock %}

