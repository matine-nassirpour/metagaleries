{% extends 'base.html.twig' %}

{% block title %}Votre panier | Meta Galeries{% endblock %}

{% block body %}
    <div class="large-container full-height-page">
        <div class="cart-container my-5">
            {% if cart|length > 0 %}
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">Article</th>
                        <th scope="col">Description</th>
                        <th scope="col">Prix</th>
                        <th scope="col">Qté</th>
                        <th scope="col">Total</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set total = null %}
                    {% for product in cart %}
                        {% set price = product.product.price/100 %}
                        {% set subtotal = (price * product.quantity) %}
                        <tr>
                            <td>
                                <img class="img-fluid" src="/build/uploads/products/{{ product.product.illustration }}" alt="{{ product.product.name }}" width="250">
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    <h1 class="text-uppercase fs-6 fw-bold">{{ product.product.name }}</h1>
                                    <span>{{ product.product.description }}</span>
                                    <span>{{ product.product.subtitle }}</span>
                                    <a class="a-remove-product mt-3" href="{{ path('app_remove_product', { 'id': product.product.id }) }}">
                                        Supprimer
                                    </a>
                                </div>
                            </td>
                            <td>
                                <span>{{ price|format_currency('EUR', {fraction_digit: 2}) }}</span>
                            </td>
                            <td>
                                <div class="d-flex">
                                    <a class="quantity-icon-container" href="{{ path('app_decrease_product', { 'id': product.product.id }) }}">
                                        <i class="fa-solid fa-circle-minus"></i>
                                    </a>
                                    <span class="px-2">{{ product.quantity }}</span>
                                    <a class="quantity-icon-container" href="{{ path('app_increase_product', { 'id': product.product.id }) }}">
                                        <i class="fa-solid fa-circle-plus"></i>
                                    </a>
                                </div>
                            </td>
                            <td>
                                <span class="fw-bold">
                                    {{ subtotal|format_currency('EUR', {fraction_digit: 2}) }}
                                </span>
                            </td>
                        </tr>
                        {% set total = total + subtotal %}
                    {% endfor %}
                    </tbody>
                </table>
                <div class="cart-summary-box">
                    <h4 class="text-uppercase fw-bold fs-6 pt-4 px-4">Sommaire de commande</h4>
                    <div class="d-flex justify-content-between mt-3 px-4 text-uppercase fs-7">
                        <span>Nombre de produit</span>
                        <span>{{ cart|length }}</span>
                    </div>
                    <div class="d-flex justify-content-between mt-3 px-4 text-uppercase fs-7">
                        <span>Total</span>
                        <span>{{ total|format_currency('EUR', {fraction_digit: 0}) }}</span>
                    </div>
                    <div class="divider-inner after-whitesmoke mt-4"></div>
                    <div class="a-button-container px-4">
                        <a href="{{ path('app_order') }}">
                            <div class="a-button a-button-tertiary">
                                <span class="a-button-inner">
                                    Valider votre panier
                                </span>
                            </div>
                        </a>
                    </div>
                </div>
            {% else%}
                <div class="empty-cart-img-container m-auto">
                    <div class="row pt-4 pb-4">
                        <div class="col-md-6">
                            <img class="img-fluid" src="{{ asset('build/images/empty-cart.png') }}" alt="Panier vide">
                        </div>
                        <div class="col-md-6 my-auto">
                            <h2 class="fw-bold">Votre panier Meta Galeries est vide</h2>
                            <h5>Trouvez votre nouveau style !</h5>
                            <div class="a-button-container btn-small mt-4">
                                <a href="{{ path('app_products') }}">
                                    <div class="a-button a-button-tertiary">
                                        <span class="a-button-inner">C'est parti</span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('full-height-page') }}
{% endblock %}
