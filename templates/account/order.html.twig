{% extends 'base.html.twig' %}

{% block title %}Vos commandes | Meta Galeries{% endblock %}

{% block body %}
    <div class="full-height-page p-4">
        <div class="medium-container">
            <ol class="ordered-list">
                <li>
                <span class="list-item">
                    <a href="{{ path('app_account') }}">Votre compte</a>
                </span>
                </li>
                <li>
                    <span class="list-item"> › </span>
                </li>
                <li>
                    <span class="list-item">Vos commandes</span>
                </li>
            </ol>
            {% if orders|length == 0 %}
                <p>Vous n'avez pas passé de commande</p>
            {% else %}
                <h3 class="address-title">Vos commandes</h3>
                <div class="orders-container">
                    {% for order in orders %}
                        <div class="order-box">
{#                            {{ dump(order) }}#}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('full-height-page') }}
{% endblock %}
