{% extends 'base.html.twig' %}

{% block title %}Meta Galeries Modifier le nom, l'email, le mot de passe{% endblock %}

{% block body %}
    <div class="full-height-page p-4">
        <div class="narrow-container">
            <ol class="ordered-list">
                <li>
                    <span class="list-item">
                        <a href="{{ path('app_account') }}">Votre compte</a>
                    </span>
                </li>
                <li>
                    <span class="list-item"> › </span>
                </li>
                <li>
                    <span class="list-item">
                        <a href="{{ path('app_account_security') }}">Connexion et sécurité</a>
                    </span>
                </li>
                <li>
                    <span class="list-item"> › </span>
                </li>
                <li>
                    <span class="list-item">Changez votre nom</span>
                </li>
            </ol>
            <h3 class="mb-3">Changez votre nom</h3>
            <div class="vertical-box">
                <div class="vertical-box-inner">
                    <div class="box-form-container">
                        {{ form_start(changeNameForm, {'attr': {'id': 'changeNameForm'}}) }}

                            {{ form_row(changeNameForm.firstName) }}
                            {{ form_row(changeNameForm.lastName) }}

                            <button class="btn button-primary mt-1" type="submit">Enregistrer les modifications</button>
                        {{ form_end(changeNameForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script defer>
        const makeFullHeightPage = (stringPageContainerClassName) => {
            const
                headerHeight = document.querySelector('.navbar-main').clientHeight,
                footerHeight = document.querySelector('.footer-main').clientHeight,
                page = document.querySelector(stringPageContainerClassName)
            ;

            return page.style.minHeight = `calc(100vh - (${headerHeight}px + ${footerHeight}px))`;
        }

        makeFullHeightPage('.full-height-page');

        const
            lastNameInput = document.querySelector('.change-name-form-lastname-input')
            changeNameFormBtn = document.querySelector('#changeNameForm button')
        ;

        lastNameInput.addEventListener('input', () => {
            changeNameFormBtn.disabled = lastNameInput.value.length < 1;
        })
    </script>
{% endblock %}
