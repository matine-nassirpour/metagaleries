{% extends 'base.html.twig' %}

{% block title %}Meta Galeries Modifier le nom, l'email, le mot de passe{% endblock %}

{% block body %}
    <div class="security-container">
        <div class="container-xxl">
            <div class="narrow-container">
                <div class="narrow-container">
                    <ol class="ordered-list">
                        <li>
                            <span class="list-item">
                                <a href="{{ path('app_account') }}">Votre compte</a>
                            </span>
                        </li>
                        <li>
                            <span class="list-item"> › </span>
                        </li>
                        <li>
                            <span class="list-item">Connexion et sécurité</span>
                        </li>
                    </ol>
                    <h3>Connexion et sécurité</h3>
                    <div class="security-box">
                        <div class="vertical-box">
                            <div class="vertical-box-inner">
                                <ul class="security-items">
                                    <li>
                                        <div class="item-row">
                                            <div class="row-info">
                                                <div class="row-info-title">
                                                    <span>Nom et prénom :</span>
                                                </div>
                                                <div class="row-user-data">
                                                    <span>{{ app.user.lastName|upper }}</span>
                                                </div>
                                            </div>
                                            <div class="row-button">
                                                <a href="#">
                                                    <div class="a-button a-button-primary">
                                                        <span class="a-button-inner">
                                                            Modifier
                                                        </span>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="item-row">
                                            <div class="row-info">
                                                <div class="row-info-title">
                                                    <span>Numéro de téléphone portable :</span>
                                                </div>
                                                <div class="row-user-data">
                                                    {# TODO: show the number phone saved in database #}
                                                    <span>+33603941673</span>
                                                </div>
                                            </div>
                                            <div class="row-button">
                                                <a href="#">
                                                    <div class="a-button a-button-primary">
                                                        <span class="a-button-inner">
                                                                {# TODO: the button show "Ajouter" if there is no number saved, else it shows "Modifier" #}
                                                                Modifier
                                                        </span>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="item-row">
                                            <div class="row-info">
                                                <div class="row-info-title">
                                                    <span>E-mail :</span>
                                                </div>
                                                <div class="row-user-data">
                                                    <span>{{ app.user.email }}</span>
                                                </div>
                                            </div>
                                            <div class="row-button d-none">
                                                <a href="#">
                                                    <div class="a-button a-button-primary">
                                                        <span class="a-button-inner">Modifier</span>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="item-row">
                                            <div class="row-info">
                                                <div class="row-info-title">
                                                    <span>Mot de passe :</span>
                                                </div>
                                                <div class="row-user-data">
                                                    <span>********</span>
                                                </div>
                                            </div>
                                            <div class="row-button">
                                                <a href="{{ path('app_change_password') }}">
                                                    <div class="a-button a-button-primary">
                                                        <span class="a-button-inner">Modifier</span>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script defer>
        const makeFullHeightPage = (stringPageContainerClassName) => {
            const
                headerHeight = document.querySelector('.navbar-main').clientHeight,
                footerHeight = document.querySelector('.footer-main').clientHeight,
                page = document.querySelector(stringPageContainerClassName)
            ;

            return page.style.minHeight = `calc(100vh - (${headerHeight}px + ${footerHeight}px))`;
        }

        makeFullHeightPage('.security-container')
    </script>
{% endblock %}
