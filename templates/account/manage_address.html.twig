{% extends 'base.html.twig' %}

{% block title %}Vos adresses | Meta Galeries{% endblock %}

{% block body %}
    {% set address = addressForm.address.vars.value %}
    <div class="full-height-page p-4">
        <div class="narrow-container">
            <ol class="ordered-list">
                <li>
                <span class="list-item">
                    <a href="{{ path('app_account') }}">Votre compte</a>
                </span>
                </li>
                <li>
                    <span class="list-item"> › </span>
                </li>
                <li>
                    <a href="{{ path('app_account_addresses') }}">
                        <span class="list-item">Vos adresses</span>
                    </a>
                </li>
                <li>
                    <span class="list-item"> › </span>
                </li>
                <li>
                    <span class="list-item">
                        {% if address is not same as "" %}
                            Modifier votre adresse
                        {% else %}
                            Nouvelle adresse
                        {% endif %}
                    </span>
                </li>
            </ol>
            <h3 class="mb-3">
                {% if address is not same as "" %}
                    Modifier votre adresse
                {% else %}
                    Ajouter une nouvelle adresse
                {% endif %}
            </h3>
            <div class="vertical-box">
                <div class="vertical-box-inner">
                    <div class="box-form-container">
                        {{ form_start(addressForm) }}
                            <div class="row">
                                <div class="col-md-12">
                                    {{ form_row(addressForm.country) }}
                                </div>
                                <div class="col-md-6 from-tablet-pr-0">
                                    {{ form_row(addressForm.firstName) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(addressForm.lastName) }}
                                </div>
                                <div class="col-md-12">
                                    {{ form_row(addressForm.phone) }}
                                </div>
                                <div class="col-md-12">
                                    {{ form_row(addressForm.address) }}
                                </div>
                                <div class="col-md-4 from-tablet-pr-0">
                                    {{ form_row(addressForm.zipCode) }}
                                </div>
                                <div class="col-md-8">
                                    {{ form_row(addressForm.city) }}
                                </div>
                            </div>

                            <button class="btn button-primary mt-1" type="submit">
                                {% if address is not same as "" %}
                                    Enregistrer les modifications
                                {% else %}
                                    Ajouter mon adresse
                                {% endif %}
                            </button>
                        {{ form_end(addressForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script defer>
        const makeFullHeightPage = (stringPageContainerClassName) => {
            const
                headerHeight = document.querySelector('.navbar-main').clientHeight,
                footerHeight = document.querySelector('.footer-main').clientHeight,
                page = document.querySelector(stringPageContainerClassName)
            ;

            return page.style.minHeight = `calc(100vh - (${headerHeight}px + ${footerHeight}px))`;
        }

        makeFullHeightPage('.full-height-page');
    </script>
{% endblock %}
