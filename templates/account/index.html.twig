{% extends 'base.html.twig' %}

{% block title %}Votre compte Meta Galeries{% endblock %}

{% block body %}
    <div class="account-container full-height-page">
        <div class="container-xxl">
            <div class="account-head">
                <h3>Votre compte</h3>
            </div>
            <div class="account-row">
                <div class="account-cell">
                    <a href="#">
                        <div class="cell-box">
                            <div class="cell-box-inner">
                                <div class="cell-box-inner-row">
                                    <div class="cell-box-img-container">
                                        <img src="{{ asset('build/images/order.png') }}" alt="Vos commandes">
                                    </div>
                                    <div class="cell-box-content-container">
                                        <h5>Vos commandes</h5>
                                        <div>
                                            <span class="cell-box-text">Suivre, retourner ou acheter à nouveau</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="account-cell">
                    <a href="{{ path('app_account_security') }}">
                        <div class="cell-box">
                            <div class="cell-box-inner">
                                <div class="cell-box-inner-row">
                                    <div class="cell-box-img-container">
                                        <img src="{{ asset('build/images/security.png') }}" alt="Connexion &amp; sécurité">
                                    </div>
                                    <div class="cell-box-content-container">
                                        <h5>Connexion &amp; sécurité</h5>
                                        <div>
                                            <span class="cell-box-text">Modifier le mot de passe, le nom et le numéro de téléphone mobile</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="account-cell">
                    <a href="{{ path('app_account_addresses') }}">
                        <div class="cell-box">
                            <div class="cell-box-inner">
                                <div class="cell-box-inner-row">
                                    <div class="cell-box-img-container">
                                        <img src="{{ asset('build/images/address.png') }}" alt="Adresses">
                                    </div>
                                    <div class="cell-box-content-container">
                                        <h5>Adresses</h5>
                                        <div>
                                            <span class="cell-box-text">Modifier les adresses et les préférences de livraison des commandes et des cadeaux</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script defer>
        const makeFullHeightPage = (stringPageContainerClassName) => {
            const
                headerHeight = document.querySelector('.navbar-main').clientHeight,
                footerHeight = document.querySelector('.footer-main').clientHeight,
                page = document.querySelector(stringPageContainerClassName)
            ;

            return page.style.minHeight = `calc(100vh - (${headerHeight}px + ${footerHeight}px))`;
        }

        makeFullHeightPage('.full-height-page');
    </script>
{% endblock %}

